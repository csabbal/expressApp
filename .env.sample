PORT=8000
PROTOCOL=https
URL=localhost
LOG_LEVEL=debug
DB_TYPE=mongo
DB_HOST=mongo
DB_PORT=27017
DB_USERNAME=root
DB_PASSWORD=password
DB_DATABASE=test
NODE_ENV=development
GOOGLE_CLIENT_ID=CLIENT_ID
GOOGLE_CLIENT_SECRET=CLIENT_SECRET
JWT_SECRET=test

# Optional: enables accepting access tokens issued by the ../oauth OIDC
# provider on requireJwt-guarded routes. Leave unset to run local-auth-only.
#OIDC_ISSUER=http://localhost:3200/oidc
#OIDC_AUDIENCE=urn:oauth-provider:services

# Optional: file upload/storage tuning — all have sane defaults, uncomment to override
#FILE_UPLOAD_DIR=./uploads
#FILE_UPLOAD_MAX_SIZE_MB=25
#FILE_LOW_QUALITY_JPEG_QUALITY=20
#FILE_LOW_QUALITY_MAX_WIDTH=320