PORT=8000
PROTOCOL=https
URL=localhost
LOG_LEVEL=debug
DB_TYPE=mongo
DB_HOST=mongo
DB_PORT=27017
DB_USERNAME=root
DB_PASSWORD=password
DB_DATABASE=test
NODE_ENV=development
GOOGLE_CLIENT_ID=CLIENT_ID
GOOGLE_CLIENT_SECRET=CLIENT_SECRET
JWT_SECRET=test

# Optional: enables accepting access tokens issued by the ../oauth OIDC
# provider on requireJwt-guarded routes. Leave unset to run local-auth-only.
#OIDC_ISSUER=http://localhost:3200/oidc
#OIDC_AUDIENCE=urn:oauth-provider:services

# Optional: file upload/storage tuning — all have sane defaults, uncomment to override
#FILE_UPLOAD_DIR=./uploads
#FILE_UPLOAD_MAX_SIZE_MB=25
#FILE_LOW_QUALITY_JPEG_QUALITY=20
#FILE_LOW_QUALITY_MAX_WIDTH=320

# Learning DB: a separate database backing the TaskType/AdditionInMoreSteps/
# SubtractionInMoreSteps resources. Own connection, own credentials — not the
# same DataSource as DB_* above, even when it happens to point at the same cluster.
LEARNING_DB_TYPE=mongo
LEARNING_DB_HOST=mongo
LEARNING_DB_PORT=27017
LEARNING_DB_USERNAME=root
LEARNING_DB_PASSWORD=password
LEARNING_DB_DATABASE=learning

# Auth DB: a separate database backing User/Permission/UserPermissions.
AUTH_DB_TYPE=mongo
AUTH_DB_HOST=mongo
AUTH_DB_PORT=27017
AUTH_DB_USERNAME=root
AUTH_DB_PASSWORD=password
AUTH_DB_DATABASE=auth

# Movie DB: a separate database backing the Movie example resource.
MOVIE_DB_TYPE=mongo
MOVIE_DB_HOST=mongo
MOVIE_DB_PORT=27017
MOVIE_DB_USERNAME=root
MOVIE_DB_PASSWORD=password
MOVIE_DB_DATABASE=movie

# General DB: a separate database backing the File resource.
GENERAL_DB_TYPE=mongo
GENERAL_DB_HOST=mongo
GENERAL_DB_PORT=27017
GENERAL_DB_USERNAME=root
GENERAL_DB_PASSWORD=password
GENERAL_DB_DATABASE=general